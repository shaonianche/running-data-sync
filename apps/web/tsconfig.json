{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@assets/*": [
        "./public/assets/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vite-plugin-svgr/client"
    ],
    "noEmit": true
  },
  "include": [
    "./src/**/*",
    "./plugins/**/*",
    "vite-env.d.ts"
  ]
}
