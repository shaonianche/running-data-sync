{
  "name": "running-data-sync",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "description": "Running and workout data synchronization and visualization monorepo",
  "author": "Yi Hong <zouzou0208@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shaonianche/running-data-sync"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "node packages/cli/dist/cli.js",
    "build:cli": "pnpm --filter @running-data-sync/core --filter @running-data-sync/cli build",
    "data:clean": "rm -f data/data.duckdb data/{GPX,TCX,FIT}_OUT/* apps/web/src/static/activities.json",
    "data:download:garmin": "node packages/cli/dist/cli.js garmin sync",
    "data:analysis:github": "node packages/cli/dist/cli.js svg --from-db --type github --output apps/web/public/assets/github.svg",
    "data:analysis:grid": "node packages/cli/dist/cli.js svg --from-db --type grid --output apps/web/public/assets/grid.svg",
    "data:analysis:grid-light": "node packages/cli/dist/cli.js svg --from-db --type grid --background-color #e5e5e5 --text-color #262626 --track-color #262626 --special-color #024a70 --special-color2 #ff8904 --output apps/web/public/assets/grid-light.svg",
    "data:analysis:github-light": "node packages/cli/dist/cli.js svg --from-db --type github --background-color #e5e5e5 --no-activity #d4d4d4 --text-color #262626 --track-color #525252 --special-color #024a70 --special-color2 #ff8904 --output apps/web/public/assets/github-light.svg",
    "dev": "pnpm --filter web dev",
    "develop": "pnpm --filter web dev",
    "serve": "pnpm --filter web serve",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm --filter @running-data-sync/core build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:run": "pnpm --filter @running-data-sync/core build && pnpm -r test:run",
    "test:coverage": "pnpm --filter @running-data-sync/core build && pnpm -r test:coverage",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build"
  },
  "engineStrict": true,
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.0",
    "@eslint-react/eslint-plugin": "^1.52.9",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.32.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
